    *,
    category_id: int,
    parameter_id: int,
    priority: int,
    is_required: bool,
    is_inherited: bool = False,
    source_category_id: int | None = None,
    min_value: Decimal | None = None,
    max_value: Decimal | None = None,
) -> dict[str, object]:

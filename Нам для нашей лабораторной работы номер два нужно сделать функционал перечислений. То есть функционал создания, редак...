        if child_enumeration is None:
            raise TreeError(
                f"Нельзя добавить вложенное перечисление: дочернее перечисление id={child_enum_id} не найдено"
            )

        if enum_id == child_enum_id:
            raise TreeError("Нельзя добавить перечисление внутрь самого себя")

        if await _enumeration_child_exists(
            session,
            enum_id=enum_id,
            child_enum_id=child_enum_id,
        ):
            raise TreeError(
                f"Нельзя добавить вложенное перечисление: id={child_enum_id} уже добавлено в перечисление id={enum_id}"
            )

        if await _enumeration_contains_child(
            session,
            enum_id=child_enum_id,
            target_enum_id=enum_id,
        ):
            raise TreeError("Нельзя добавить вложенное перечисление: операция создает цикл")

        result = await session.execute(
            insert(enumeration_children_table)
            .values(
                enum_id=enum_id,
                child_enum_id=child_enum_id,
                priority=priority,
                description=description.strip() if description else None,
            )
            .returning(enumeration_children_table.c.id)
        )
        child_link_id = int(result.scalar_one())
        await session.commit()

    children = await list_enumeration_children(enum_id)
    for child in children:
        if int(child["id"]) == child_link_id:
            return child
    raise RuntimeError("Enumeration child link not found after creation")


